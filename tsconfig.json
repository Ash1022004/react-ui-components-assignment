{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Node",   // ✅ Use "Node" (Storybook expects this)
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["vitest/globals", "vite/client"]
  },
  "include": ["src", ".storybook", "src/**/*.stories.tsx", "src/**/*.stories.mdx"],
  "exclude": ["node_modules", "dist", "storybook-static"]
}
